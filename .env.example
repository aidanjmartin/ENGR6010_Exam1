# Copy to .env (untracked) and fill in. Never commit .env.
# Robot serial number, from the Unitree app or the label on the robot
GO2_SERIAL=
# Robot IP address on the Wi-Fi or wired network used for WebRTC
GO2_IP=
# Per-device AES-128 key from unitree-fetch-aes-key (firmware 1.1.15 and later)
GO2_AES_KEY=
# Name of this computer's Ethernet interface to the robot (the USB-C adapter)
GO2_ETH_IFACE=
